# Copy this file to .env.local and fill in your values
# Get these from your Supabase project: Settings > API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: only needed if you call Anthropic directly from Edge Functions
# Never put this in the frontend — add it as a Supabase secret instead
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...

# ── Demo Mode (optional) ──────────────────────
# Set to "true" to start the app in demo mode (Jane Doe's pre-seeded data).
# The app skips login and shows data immediately.
# Set to "false" or remove entirely for normal production use.
# Default: false
#VITE_DEMO_MODE=false

# ── AI / Edge Functions ───────────────────────
# The Anthropic API key MUST NOT go in this file.
# Add it as a Supabase secret instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# It is only used server-side in the ai-proxy Edge Function.


# For Google OAuth, scroll down to Google in the Auth Providers list (visible at the bottom of your screenshot) and click the > arrow to expand it. You'll need:
# A Google Cloud Console project with OAuth 2.0 credentials
# The Client ID and Client Secret from Google
# Add https://your-project-ref.supabase.co/auth/v1/callback as an authorized redirect URI in Google Console
# If you don't need Google login right now, you can skip it — email/password login works out of the box.


# setting up AI Advisor ANTHROPIC_API_KEY
# Set the key: in the vs code terminal
# npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-xxx...
# Deploy the logic:
# npx supabase functions deploy ai-advisor --no-verify-jwt